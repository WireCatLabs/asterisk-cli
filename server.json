{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.wirecat/asterisk-cli",
  "title": "WireCat asterisk",
  "description": "asterisk for agents over MCP. Set up a profile with the asterisk CLI first.",
  "websiteUrl": "https://wirecat.dev/en/docs/pbx",
  "repository": {
    "url": "https://github.com/WireCatLabs/asterisk-cli",
    "source": "github"
  },
  "version": "0.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@wirecat/asterisk-cli",
      "version": "0.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--profiles",
          "value": "all"
        }
      ]
    }
  ]
}
