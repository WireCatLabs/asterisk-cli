{
  "wcat_manifest": 2,
  "name": "pbx",
  "description": "Asterisk PBX calls and recordings as meetings: import the CDR, transcribe on this computer, search",
  "docs_url": "https://wirecat.dev/en/docs/pbx",
  "package": "@wirecat/asterisk-cli",
  "bin": "wcat-pbx",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "summary": "every command by section; --json prints its contract, one path per call",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "summary": "one command contract, or all schemas, error reasons and explicit overrides",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "summary": "check the profile's Asterisk source and keep its password",
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "summary": "show where this profile's password comes from; never the password",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "summary": "forget this profile's password on this computer; imported calls stay",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "summary": "list the profiles here and whether each is signed in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "account",
        "remove"
      ],
      "summary": "sign this profile out and forget it, keeping or deleting its data",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "account.remove",
      "entity": "account_removal"
    },
    {
      "path": [
        "meetings",
        "list"
      ],
      "summary": "meetings, newest first: the service's and the stored ones, kept in the store",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "meetings.list",
      "entity": "meeting"
    },
    {
      "path": [
        "meetings",
        "show"
      ],
      "summary": "show a meeting, read again from the service with its people, transcript and…",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "meetings.show",
      "entity": "meeting_details"
    },
    {
      "path": [
        "meetings",
        "transcript"
      ],
      "summary": "show current meeting transcripts",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "meetings.transcript",
      "entity": "meeting_transcript"
    },
    {
      "path": [
        "meetings",
        "summary"
      ],
      "summary": "show stored meeting summaries",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "meetings.summary",
      "entity": "meeting_summary"
    },
    {
      "path": [
        "meetings",
        "export"
      ],
      "summary": "export a meeting as Markdown or one transcript as WebVTT",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "meetings.export",
      "entity": "meeting_export"
    },
    {
      "path": [
        "meetings",
        "people"
      ],
      "summary": "find meeting participants by name or email",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "meetings.people",
      "entity": "meeting_participants"
    },
    {
      "path": [
        "meetings",
        "sync"
      ],
      "summary": "bring the stored meetings up to date from the connected account, oldest…",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "meetings.sync",
      "entity": "meeting_ingestion"
    },
    {
      "path": [
        "meetings",
        "import"
      ],
      "summary": "import downloaded meeting transcripts",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "meetings.import",
      "entity": "meeting_ingestion"
    },
    {
      "path": [
        "meetings",
        "repair"
      ],
      "summary": "preview filling in what older builds left out of stored transcripts (their…",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "meetings.repair",
      "entity": "meeting_repair"
    },
    {
      "path": [
        "meetings",
        "embed"
      ],
      "summary": "preview building the vectors search by meaning reads; --yes builds one batch, rerun for the next",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "meetings.embed"
    },
    {
      "path": [
        "meetings",
        "transcribe"
      ],
      "summary": "turn call recordings into text, on this computer or a chosen service",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "meetings.transcribe",
      "entity": "call_transcription_report"
    },
    {
      "path": [
        "events",
        "list"
      ],
      "summary": "list stored events",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "events.list",
      "entity": "event"
    },
    {
      "path": [
        "stats",
        "calls",
        "show"
      ],
      "summary": "calls by direction, outcome, employee, hour and day; missed calls and callbacks",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "stats.calls.show",
      "entity": "call_stats"
    },
    {
      "path": [
        "search",
        "meetings"
      ],
      "summary": "find words in stored meetings, and by meaning with --model",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "search.meetings",
      "entity": "meeting_hit"
    },
    {
      "path": [
        "tags",
        "add"
      ],
      "summary": "put tags on stored meetings",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "tags.add",
      "entity": "meeting_tag_change"
    },
    {
      "path": [
        "tags",
        "remove"
      ],
      "summary": "take tags off stored meetings",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "tags.remove",
      "entity": "meeting_tag_change"
    },
    {
      "path": [
        "tags",
        "list"
      ],
      "summary": "tagged meetings of this account, with their tags",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "tags.list",
      "entity": "meeting_tagging"
    },
    {
      "path": [
        "models",
        "list"
      ],
      "summary": "speech and embedding models, their download status and the default of each kind",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "models.list",
      "entity": "model"
    },
    {
      "path": [
        "models",
        "download"
      ],
      "summary": "download and verify one speech or embedding model",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "models.download",
      "entity": "model"
    },
    {
      "path": [
        "models",
        "set"
      ],
      "summary": "use this text model for every embed and search by meaning, in every CLI",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "models.set",
      "entity": "model"
    },
    {
      "path": [
        "models",
        "add"
      ],
      "summary": "add an ONNX embedding model from Hugging Face, pinned and checked by sha256",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "models.add",
      "entity": "model"
    },
    {
      "path": [
        "doctor"
      ],
      "summary": "the state this installation is in, without connecting unless --online",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "doctor",
        "reports",
        "show"
      ],
      "summary": "what a report holds and never holds, and where to send it; writes nothing",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "doctor",
        "reports",
        "create"
      ],
      "summary": "the report file written: its path, the run it is about, and where to send it",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "doctor.reports.create"
    },
    {
      "path": [
        "skill",
        "show"
      ],
      "summary": "print the tool's instructions for AI agents",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "skill",
        "install"
      ],
      "summary": "install the tool's instructions for AI agents",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "skill",
        "status"
      ],
      "summary": "whether the installed instructions for AI agents match this version",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "serve"
      ],
      "summary": "serve this profile's commands to an AI agent",
      "effects": {
        "remote": "write",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "revoke"
      ],
      "summary": "forget every login given to a browser app",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "start"
      ],
      "summary": "start the HTTP MCP server in the background",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "stop"
      ],
      "summary": "stop the background HTTP MCP server",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "status"
      ],
      "summary": "whether the HTTP MCP server runs, its login code and the apps logged in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "config"
      ],
      "summary": "print the local MCP configuration of this profile, or of those --profiles names",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "add"
      ],
      "summary": "add this profile's local MCP server to Codex or Claude Code",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "check"
      ],
      "summary": "check this profile's local MCP handshake and tool list",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "upgrade"
      ],
      "summary": "upgrade pbx with the package manager that installed it; --check only looks",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "show"
      ],
      "summary": "the profile, the profiles that exist, and each setting with where it came from",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "config",
        "set"
      ],
      "summary": "save a setting to the configuration file",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "unset"
      ],
      "summary": "remove a setting from the configuration file",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "migrate"
      ],
      "summary": "write each setting the file lacks at its default, keeping yours",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "repair"
      ],
      "summary": "fix the settings file's JSON syntax, keeping every value",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "setup"
      ],
      "summary": "connect this profile, question by question",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "setup"
    },
    {
      "path": [
        "setup",
        "show"
      ],
      "summary": "print the connection flow as JSON, for WireCat Desktop",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "setup.show"
    },
    {
      "path": [
        "setup",
        "apply"
      ],
      "summary": "check the answers on stdin against the flow, and save them",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "setup.apply"
    },
    {
      "path": [
        "setup",
        "run"
      ],
      "summary": "run one step of the flow, as WireCat Desktop does",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "setup.run"
    },
    {
      "path": [
        "runs",
        "list"
      ],
      "summary": "recorded runs, newest first",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "entity": "run"
    },
    {
      "path": [
        "runs",
        "show"
      ],
      "summary": "one run: what it was, how it ended, and every event it logged",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "entity": "run"
    },
    {
      "path": [
        "runs",
        "path"
      ],
      "summary": "the directory holding one run",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "entity": "run_location"
    }
  ],
  "entities": {
    "meeting": {
      "fields": [
        "id",
        "provider_id",
        "title",
        "started_at",
        "ended_at",
        "duration_ms",
        "participants_count",
        "created_at",
        "updated_at"
      ]
    },
    "event": {
      "fields": [
        "id",
        "origin",
        "starts_at",
        "ends_at",
        "created_at",
        "updated_at"
      ]
    },
    "meeting_tagging": {
      "fields": [
        "tag"
      ]
    },
    "model": {
      "fields": [
        "kind",
        "id",
        "downloaded"
      ]
    },
    "run": {
      "fields": [
        "run_id",
        "command",
        "profile",
        "started_at",
        "completed_at",
        "status",
        "requests",
        "duration_ms",
        "cli_version",
        "runtime",
        "platform",
        "arch",
        "error_code",
        "provider_error",
        "kept_because_failed",
        "operations",
        "codes",
        "trace_id",
        "cli_command",
        "argv",
        "unknown_command",
        "via",
        "events_dropped",
        "directory",
        "event_count",
        "events_truncated"
      ]
    }
  },
  "network": {
    "hosts": [
      "api.openai.com",
      "registry.npmjs.org",
      "huggingface.co",
      "*.huggingface.co",
      "*.hf.co",
      "github.com",
      "*.githubusercontent.com"
    ],
    "user_hosts": "the Asterisk CDR database, its SSH server or the SFTP server you set up"
  },
  "desktop": {
    "tagline": "Asterisk calls and recordings, searchable",
    "profiles": {
      "args": [
        "session",
        "list",
        "--no-record",
        "--json"
      ],
      "shape": "items"
    },
    "doctor": [
      "{profile}",
      "doctor",
      "--record",
      "--json"
    ],
    "runs": {
      "list": [
        "runs",
        "list",
        "{query}",
        "--limit",
        "{limit}",
        "--page",
        "{page}",
        "--no-record",
        "--json"
      ],
      "show": [
        "runs",
        "show",
        "{run}",
        "--no-record",
        "--json"
      ]
    },
    "search": null,
    "setup": [
      "{profile}",
      "setup"
    ],
    "signIn": {
      "gives": "Lets your agent find your company's phone calls and read what was said in them.",
      "asks": "The path of Master.csv, or the CDR database's address and a read-only user's password.",
      "setupFrom": "0.0.0"
    },
    "skill": {
      "status": [
        "skill",
        "status",
        "--no-record",
        "--json"
      ],
      "install": [
        "skill",
        "install",
        "--for",
        "{target}",
        "--json"
      ],
      "show": [
        "skill",
        "show",
        "--no-record",
        "--json"
      ]
    },
    "mcpServer": {
      "start": [
        "mcp",
        "server",
        "start",
        "--port",
        "{port}",
        "--public-url",
        "{url}",
        "--profiles",
        "all",
        "--json"
      ],
      "stop": [
        "mcp",
        "server",
        "stop",
        "--profiles",
        "all",
        "--json"
      ],
      "status": [
        "mcp",
        "server",
        "status",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ],
      "revoke": [
        "mcp",
        "revoke",
        "--profiles",
        "all",
        "--json"
      ],
      "config": [
        "mcp",
        "config",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ]
    },
    "tasks": null,
    "sync": {
      "run": [
        "{profile}",
        "meetings",
        "sync",
        "--record",
        "--json"
      ],
      "last": [
        "runs",
        "list",
        "command:\"meetings sync\" status:success",
        "--limit",
        "50",
        "--no-record",
        "--json"
      ],
      "lastShape": "runs",
      "what": "call records and their recordings",
      "note": null
    },
    "storeInfo": null,
    "storeTables": null,
    "storeTableSizes": null,
    "storeCheck": null,
    "storeBackup": null,
    "storeBackupEncrypted": null,
    "storeResetPreview": null,
    "storeReset": null,
    "storage": {
      "app": "asterisk-cli",
      "env": "PBX"
    },
    "settings": null,
    "accountRemove": {
      "signOut": [
        "{profile}",
        "session",
        "end",
        "--record",
        "--json"
      ],
      "remove": {
        "minVersion": "0.0.0",
        "keepData": [
          "{profile}",
          "account",
          "remove",
          "--keep-data",
          "--record",
          "--json"
        ],
        "deleteData": [
          "{profile}",
          "account",
          "remove",
          "--delete-data",
          "--record",
          "--json"
        ],
        "dryRun": "--dry-run",
        "confirm": "--yes"
      },
      "removes": [
        "signIn"
      ],
      "keeps": [
        "settings",
        "data",
        "listed"
      ]
    }
  }
}
